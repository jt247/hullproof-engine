<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.acme.notes">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".NotesApp"
        android:allowBackup="true"
        android:debuggable="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:theme="@style/Theme.Notes">

        <meta-data android:name="com.acme.notes.STRIPE_SECRET_KEY" android:value="fixture-stripe-secret-value-0000" />
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="@string/maps_key" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".DeepLinkActivity" android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="notes.acme.test" android:pathPrefix="/n" />
            </intent-filter>
        </activity>

        <receiver android:name=".ShareReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.acme.notes.SHARE" />
            </intent-filter>
        </receiver>

        <service android:name=".SyncService" android:exported="false" />

        <provider
            android:name=".ExportProvider"
            android:authorities="com.acme.notes.export"
            android:exported="true" />
    </application>
</manifest>
