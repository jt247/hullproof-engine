                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "kind",
                    "file",
                    "line",
                    "note"
                  ]
                },
                "minItems": 1,
                "maxItems": 12
              },
              "verified_by": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "agent": {
                    "const": "hullproof-finding-verifier"
                  },
                  "mode": {
                    "const": "handoff"
                  },
                  "outcome": {
                    "enum": [
                      "UPHELD",
                      "ADJUSTED",
                      "INSUFFICIENT"
                    ]
                  },
                  "call": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "agent",
                  "mode",
                  "outcome",
                  "call"
                ]
              }
            },
            "required": [
              "fingerprint",
              "kind",
              "sec_ids",
              "title",
              "state",
              "reason",
              "owner_action",
              "check_card",
              "raised_by",
              "boundary"
            ]
          },
