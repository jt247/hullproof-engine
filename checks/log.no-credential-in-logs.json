{
  "id": "check.log.no-credential-in-logs",
  "sec_ids": [
    "SEC-LOG-001"
  ],
  "applies_when": {},
  "op": "regex_absent",
  "params": {
    "files": [
      "**/*.{ts,tsx,js,jsx,mjs,cjs,py,rb,php,go,java,kt,cs,rs,dart,swift,vue,svelte,astro}"
    ],
    "exclude": [
      "**/*.test.*",
      "**/*.spec.*",
      "**/__tests__/**",
      "**/test/**",
      "**/tests/**",
      "**/fixtures/**"
    ],
    "pattern": "\\b(?:console\\.(?:log|info|warn|error|debug)|logger\\.\\w+|log\\.(?:info|warn|warning|error|debug|print\\w*)|logging\\.\\w+|print|println|Log\\.\\w|puts|error_log)\\s*\\([^\\n]*(?:\\b(?:token|password|passwd|secret|api_?key|apiKey|access_?token|accessToken|refresh_?token|refreshToken|session_?token|sessionToken|authorization|card_?number|cvv)\\b\\s*[:=,})]|\\.(?:token|password|secret|accessToken|refreshToken|apiKey)\\b)",
    "note": "a credential is written to the logs",
    "not_applicable_reason": "no source file"
  },
  "on_true": "NOT ASSESSED: NEEDS DYNAMIC TEST",
  "on_false": "FAIL",
  "fixtures": {
    "pass": "test/fixtures/checks/no-credential-in-logs/pass",
    "fail": "test/fixtures/checks/no-credential-in-logs/fail"
  }
}
