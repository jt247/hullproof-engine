{
  "id": "check.secrets.no-env-file-committed",
  "sec_ids": [
    "SEC-SECRETS-004"
  ],
  "applies_when": {},
  "op": "file_absent",
  "params": {
    "files": [
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*"
    ],
    "exclude": [
      "**/.env.example",
      "**/.env.sample",
      "**/.env.template",
      "**/.env.dist",
      "**/.env.*.example",
      "**/.env.example.*"
    ],
    "note": "an environment file is in the repository; its values are readable by anyone with the code"
  },
  "on_true": "NOT ASSESSED: NEEDS DASHBOARD",
  "on_false": "FAIL",
  "fixtures": {
    "pass": "test/fixtures/checks/no-env-file-committed/pass",
    "fail": "test/fixtures/checks/no-env-file-committed/fail"
  }
}
