{
  "id": "check.secrets.no-secret-in-public-env",
  "sec_ids": [
    "SEC-SECRETS-001",
    "SEC-SECRETS-003"
  ],
  "applies_when": {},
  "op": "regex_absent",
  "params": {
    "files": [
      "**/*.{ts,tsx,js,jsx,mjs,cjs,py,rb,php,go,java,kt,cs,rs,dart,swift,vue,svelte,astro}",
      "**/.env*",
      "**/app.json",
      "**/app.config.*",
      "**/eas.json",
      "**/vercel.json",
      "**/netlify.toml"
    ],
    "exclude": [
      "**/*.test.*",
      "**/*.spec.*",
      "**/__tests__/**",
      "**/test/**",
      "**/tests/**",
      "**/fixtures/**"
    ],
    "pattern": "\\b(?:NEXT_PUBLIC|VITE|EXPO_PUBLIC|REACT_APP|NUXT_PUBLIC|PUBLIC|GATSBY|STORYBOOK)_[A-Z0-9_]*(?:SERVICE_ROLE|SECRET|PRIVATE|PASSWORD|PASSWD)[A-Z0-9_]*\\b",
    "note": "a secret is named with a prefix the framework copies into the browser or app bundle",
    "not_applicable_reason": "no source or environment file"
  },
  "on_true": "NOT ASSESSED: NEEDS BUILD",
  "on_false": "FAIL",
  "fixtures": {
    "pass": "test/fixtures/checks/no-secret-in-public-env/pass",
    "fail": "test/fixtures/checks/no-secret-in-public-env/fail"
  }
}
